---
import CopyButton from "./copyButton.astro";

const email = "kzhao132018@gmail.com";
const links = [
    {
        name: "Github",
        url: "https://github.com/Makkerel",
        description: "Code & projects",
    },
    {
        name: "LinkedIn",
        url: "https://www.linkedin.com/in/kevin-zhao-955069334",
        description: "Professional",
    },
    {
        name: "Resume",
        url: "/resume.pdf",
        description: "PDF download",
    },
];
---

<div class="find-me-grid">
    <div class="find-me-item">
        <a href={`mailto:${email}`} class="find-me-name">Email</a>
        <CopyButton text={email} label="Copy email address">
            <span class="find-me-desc email-address">{email}</span>
        </CopyButton>
    </div>
    {
        links.map(({ name, url, description }) => (
            <a
                class="find-me-item"
                href={url}
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="find-me-name">{name}</span>
                <span class="find-me-desc">{description}</span>
            </a>
        ))
    }
</div>

<style>
    .find-me-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .find-me-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem;
        border: 1px solid var(--secondary-color);
        transition: filter 0.3s ease;
    }

    .find-me-item:hover {
        filter: brightness(150%);
    }

    .find-me-name {
        font-family: var(--font-exo-2), sans-serif;
        font-size: 1.1rem;
        color: var(--accent-color);
    }

    .find-me-desc {
        color: var(--secondary-color);
        font-size: 0.85rem;
    }

    .email-address {
        padding-right: 0.25rem;
        font-family: var(--font-share-tech);
    }

    @media (max-width: 600px) {
        .find-me-grid {
            grid-template-columns: 1fr;
        }

        .find-me-item {
            border-right: none;
            border-left: none;
            border-bottom: 1px solid var(--secondary-color);
        }
    }
</style>
